generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  
}

model Project {
  id          Int      @id @default(autoincrement())

  slug        String   @unique
  titre       String

  description String?
  problem     String?
  solution    String?
  result      String?

  category    String?

    // Nouveaux champs
  isSelected  Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  metric1     String?
  metric2     String?

  domains     ProjectDomain[]
  services    ProjectService[]
  stacks      ProjectStack[]
  images      ProjectImage[]
  visits      ProjectVisit[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Domain {
  id        Int      @id @default(autoincrement())

  key       String   @unique
  label     String

  color     String

  projects  ProjectDomain[]
}

model ProjectDomain {
  projectId Int
  domainId  Int

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain    Domain  @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([projectId, domainId])
}

model Service {
  id          Int      @id @default(autoincrement())

  title       String
  description String?

  projects    ProjectService[]
}

model ProjectService {
  projectId Int
  serviceId Int

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

model Stack {
  id        Int      @id @default(autoincrement())

  name      String   @unique

  projects  ProjectStack[]
}

model ProjectStack {
  projectId Int
  stackId   Int

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stack     Stack   @relation(fields: [stackId], references: [id], onDelete: Cascade)

  @@id([projectId, stackId])
}

model ProjectImage {
  id        Int      @id @default(autoincrement())

  url       String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Pricing {
  id          Int      @id @default(autoincrement())

  name        String
  description String

  price       String

  featured    Boolean  @default(false)

  badge       String?
  cta         String?

  features    PricingFeature[]
}

model PricingFeature {
  id          Int      @id @default(autoincrement())

  text        String

  pricingId   Int
  pricing     Pricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
}

model Process {
  id          Int      @id @default(autoincrement())

  number      String
  title       String

  description String
}

model ContactMessage {
  id          Int      @id @default(autoincrement())

  name        String
  email       String

  category    String
  subject     String
  message     String

  status      String   @default("new")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteRequest {
  id          Int      @id @default(autoincrement())

  name        String
  email       String

  company     String?

  projectType String
  description String

  budget      String?
  timeline    String?

  status      String   @default("new")

  attachments QuoteAttachment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteAttachment {
  id        Int      @id @default(autoincrement())

  fileName  String
  filePath  String
  fileSize  Int

  quoteId   Int
  quote     QuoteRequest @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())
}

model ProjectVisit {
  id        Int      @id @default(autoincrement())

  visitorId String
  projectId Int

  duration  Int      @default(0)

  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([projectId])
}